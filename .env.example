# Пример переменных окружения. Скопируйте в .env (локально) или задайте
# через панель хостинга. .env в git НЕ коммитится.

# --- Безопасность (обязательно на проде) ---
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=False
ALLOWED_HOSTS=ВАШ_ЛОГИН.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://ВАШ_ЛОГИН.pythonanywhere.com

# --- MySQL на PythonAnywhere ---
# Данные берутся со вкладки Databases в панели PythonAnywhere.
MYSQL_DB=ВАШ_ЛОГИН$dachakaz
MYSQL_USER=ВАШ_ЛОГИН
MYSQL_PASSWORD=пароль_от_БД
MYSQL_HOST=ВАШ_ЛОГИН.mysql.pythonanywhere-services.com
MYSQL_PORT=3306